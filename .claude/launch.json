{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "victor-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-u", "-m", "uvicorn", "backend.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "victor-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "3000"],
      "port": 3000
    }
  ]
}
